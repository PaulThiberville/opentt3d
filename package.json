{
  "name": "opentt3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OpenTTD en 3D : moteur OpenTTD headless en WebAssembly, frontend Three.js, multijoueur P2P",
  "license": "GPL-2.0-or-later",
  "author": "Paul Thiberville",
  "desktopName": "OpenTT3D.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "icon": "electron build/generate-icon.cjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:multi": "node scripts/e2e.mjs --scenario=multi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf": "node scripts/perf.mjs",
    "perf:quick": "node scripts/perf.mjs --sizes=128 --qualities=medium --engine=mock --duration=4 --soak=0",
    "engine:fetch": "bash engine/scripts/fetch.sh",
    "engine:build": "bash engine/scripts/build.sh",
    "engine:test": "node engine/scripts/smoke.mjs",
    "engine:test:commands": "node engine/scripts/commands.mjs",
    "engine:test:save": "node engine/scripts/save.mjs"
  },
  "dependencies": {
    "nostr-tools": "2.26.0",
    "three": "0.187.0",
    "trystero": "0.27.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/three": "0.187.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "io.github.paulthiberville.opentt3d",
    "productName": "OpenTT3D",
    "copyright": "© 2026 Paul Thiberville",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "electron/afterPack.cjs",
    "mac": {
      "category": "public.app-category.strategy-games",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "OpenTT3D ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenTT3D",
      "artifactName": "${productName}-${version}-windows-setup.${ext}",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "language": "1036"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
